{
  "name": "react-native-glide-ui",
  "version": "1.0.0",
  "description": "AI-powered adaptive UI system with gesture-driven interactions, automatic performance optimization, and intelligent layout adaptation for React Native & Expo",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "build": "bob build",
    "typescript": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "prepare": "bob build",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "expo",
    "ui",
    "adaptive",
    "gestures",
    "animations",
    "performance",
    "ai",
    "optimization",
    "layout",
    "responsive",
    "accessibility",
    "haptics",
    "smooth",
    "glide"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/da-war/react-native-glide-ui"
  },
  "author": "YOUR_NAME <your.email@example.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/da-war/react-native-glide-ui/issues"
  },
  "homepage": "https://github.com/da-war/react-native-glide-ui#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@react-native/eslint-config": "^0.74.0",
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.73.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "react": "^18.2.0",
    "react-native": "^0.74.0",
    "react-native-builder-bob": "^0.23.0",
    "react-native-gesture-handler": "^2.16.0",
    "react-native-reanimated": "^3.8.0",
    "release-it": "^17.0.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.70.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-gesture-handler": {
      "optional": false
    },
    "react-native-reanimated": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=18"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    }
  }
}
