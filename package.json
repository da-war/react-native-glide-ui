{
  "name": "react-native-glide-ui",
  "version": "1.0.3",
  "description": "Adaptive UI system with smooth animations, gesture detection, haptic feedback, and automatic performance optimization for React Native & Expo",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "build": "bob build",
    "typescript": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "prepare": "bob build",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "expo",
    "ui",
    "adaptive",
    "gestures",
    "animations",
    "performance",
    "optimization",
    "layout",
    "responsive",
    "accessibility",
    "haptics",
    "smooth",
    "glide"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/da-war/react-native-glide-ui.git"
  },
  "author": "Rana Dawar <ranadawarabdullah@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/da-war/react-native-glide-ui/issues"
  },
  "homepage": "https://github.com/da-war/react-native-glide-ui#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "react-native": "^0.74.0",
    "react-native-builder-bob": "^0.23.0",
    "react-native-gesture-handler": "^2.16.0",
    "react-native-reanimated": "^3.8.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.68.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-gesture-handler": {
      "optional": false
    },
    "react-native-reanimated": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=16"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
